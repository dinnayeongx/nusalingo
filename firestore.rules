rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserDocument(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(data) {
      return data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 50
        && data.email is string
        && data.email == request.auth.token.email
        && data.selectedScript in ['Aksara Jawa', 'Aksara Sunda', 'Aksara Bali']
        && data.experience in [
          'Aku baru pertama kali belajar',
          'Aku tahu beberapa bentuk dasar hurufnya',
          'Aku bisa membaca kata-kata sederhana',
          'Aku bisa membaca dan menulis kalimat dasar',
          'Aku sudah lancar membaca dan menulis'
        ]
        && data.learningGoals is list
        && data.learningGoals.size() >= 1
        && data.learningGoals.size() <= 6
        && data.learningGoals.hasOnly([
          'Hanya untuk bersenang-senang',
          'Mendukung pelajaran sekolah',
          'Mendukung pekerjaan / karier',
          'Mengenal budaya & leluhur',
          'Mengisi waktu luang',
          'Lainnya'
        ])
        && data.onboardingCompleted == true;
    }

    match /users/{userId} {
      allow read: if ownsUserDocument(userId);

      allow create: if ownsUserDocument(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'selectedScript',
          'experience',
          'learningGoals',
          'onboardingCompleted',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName',
          'email',
          'selectedScript',
          'experience',
          'learningGoals',
          'onboardingCompleted',
          'createdAt'
        ])
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if ownsUserDocument(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'selectedScript',
          'experience',
          'learningGoals',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName',
          'email',
          'selectedScript',
          'experience',
          'learningGoals',
          'onboardingCompleted',
          'createdAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'selectedScript',
          'experience',
          'learningGoals',
          'onboardingCompleted',
          'updatedAt'
        ])
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validProfile(request.resource.data);

      allow delete: if false;
    }
  }
}
